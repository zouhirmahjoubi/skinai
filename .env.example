# YouCam API key from https://yce.perfectcorp.com/api-console/en/api-keys/
# Leave empty to run in demo mode (synthetic results, no units spent).
YOUCAM_API_KEY=

# Recommended on any public deployment: a long random code. The app asks for
# it once (or reads it from a link like https://your-host/?code=...).
APP_ACCESS_CODE=

# YouCam units per IP per day (default 100: a print is 30, an HD check-in 16,
# an SD check-in 12, a hair or hat try-on 2, a brow preview 1).
PER_IP_DAILY_UNITS=100
# YouCam units for the whole server per UTC day (default 300).
DAILY_UNIT_BUDGET=300

# Reverse proxies in front of the server: 1 on Render, 0 when exposed directly.
# Wrong values let clients spoof their IP and bypass the per-IP limit.
TRUST_PROXY=0

# The Ask companion: a KIE API key (https://kie.ai) for Claude, falling back to
# GPT-6 Luna. Leave empty and Ask answers from the rules alone, labelled demo.
KIE_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Companion questions per IP and for the whole server per UTC day.
PER_IP_DAILY_CHATS=40
DAILY_CHAT_BUDGET=400

PORT=8787
