# YouCam API key from https://yce.perfectcorp.com/api-console/en/api-keys/
# Leave empty to run in demo mode (synthetic results, no units spent).
YOUCAM_API_KEY=

# Optional: protect your units on a public deployment. When set, the app asks
# for this code once and sends it with every API call.
APP_ACCESS_CODE=

# Optional: max paid YouCam tasks per IP per day (default 40).
PER_IP_DAILY_LIMIT=40

PORT=8787
